# lifestyle 대시보드 환경변수 템플릿
# 실제 값을 채운 뒤 .env.local 로 복사하세요 (.env.local 은 커밋 금지).

# ── 필수: Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 컨텐츠 검증 (verify) ──
ANTHROPIC_API_KEY=
DART_API_KEY=
NOTION_API_KEY=
NOTION_DB_VERIFY_TENANT_ID=
NOTION_DB_VERIFY_NEWS_ID=

# ── 브랜드 키워드 / 뉴스 ──
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── 데이터 수집 스크립트 ──
KAKAO_REST_API_KEY=
DATA_GO_KR_POP_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
SEOUL_OPEN_API_KEY=
