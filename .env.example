# ============================================================
# Gana — 환경변수 템플릿
# 이 파일은 Git에 커밋됩니다. 실제 값은 .env.local 에만 작성하세요.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 서버 전용 — 절대 클라이언트 코드에서 사용 금지
# Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 사이트 URL ────────────────────────────────────────────────
# 프로덕션 배포 URL (Vercel에서 자동 설정되지만 명시 권장)
# Supabase Dashboard > Authentication > URL Configuration > Site URL 에도 동일하게 등록 필요
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── 카카오 지도 (상권분석 매장 상세 페이지) ────────────────────
# Kakao Developers Console > 내 애플리케이션 > 앱 키 > "JavaScript 키"
# 콘솔의 플랫폼 → Web 사이트 도메인 등록 필요 (localhost / vercel 도메인)
NEXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-javascript-key

# ── k-skill-proxy (실거래가 OpenAPI 게이트웨이) ────────────────
# 기본값은 NomaDamas 호스팅 프록시. 별도 자체 호스팅 시에만 변경.
# KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org

# ── 데이터 수집 스크립트 (런타임 미사용) ───────────────────────
# scripts/geocode-stores.mjs 실행 시 — Kakao Developers REST API 키
# KAKAO_REST_API_KEY=your-kakao-rest-api-key
#
# scripts/fetch-trade-area.mjs 실행 시 — data.go.kr 소상공인 상가업소 API
# SBIZ_API_KEY=your-public-data-portal-decoding-key
